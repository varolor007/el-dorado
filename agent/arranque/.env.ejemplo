# El .env de la casa de El Dorado. Se copia a .env (cp .env.ejemplo .env), se rellena en el servidor y no se sube
# nunca: lleva tu token y las claves de las fuentes. La guía (guia.md) dice qué va en cada línea.
# Sin comillas y sin espacios alrededor del igual.

# Cómo llega Vercel a la casa: puerta (una dirección con HTTPS y el 443 abierto) o tunel (ngrok, no abre nada).
ELDORADO_LLEGADA=puerta

# La IA de la casa: tu token de `claude setup-token`, los correos que piensan con tu cuenta (separados por comas)
# y el modelo. El esfuerzo, si se quiere.
ELDORADO_TOKEN_DE_CLAUDE=
ELDORADO_CORREOS_DE_LA_CASA=
ELDORADO_MODELO=
ELDORADO_ESFUERZO=

# Solo si la casa admite también la clave de cada viajero: lo que cuesta el modelo, en dólares por millón.
ELDORADO_PRECIO_ENTRADA=
ELDORADO_PRECIO_SALIDA=

# Las claves de las fuentes. La de Geoapify, si la hay.
LITEAPI_KEY=
TRAVELPAYOUTS_TOKEN=
PARALLEL_API_KEY=
GEOAPIFY_KEY=

# De dónde se leen los horarios de OpenStreetMap (su servicio de lectura, Overpass): direcciones https separadas
# por comas, que se prueban en orden. En blanco, la principal. No lleva clave. Si ninguna contesta, el viaje sale
# igual y lo dice.
ELDORADO_OVERPASS=

# La puerta (ELDORADO_LLEGADA=puerta). Un correo para el certificado (te avisan si caduca). La dirección, en
# blanco para la gratuita (el guion pone <tu-ip>.sslip.io), o un dominio tuyo que apunte a la IP del servidor.
ELDORADO_CORREO_DEL_CERTIFICADO=
ELDORADO_DOMINIO=

# El túnel (ELDORADO_LLEGADA=tunel): la llave de ngrok y su dirección fija, propias de El Dorado.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# El tope de la casa, para no quitarle sitio al ensamblador (memoria y núcleos), y cuánto se espera al ponerse al
# día a que acabe lo que investiga.
ELDORADO_MEMORIA=3g
ELDORADO_NUCLEOS=2
ELDORADO_ESPERA_AL_APAGAR=60m
